    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Cluster size (wsrep_cluster_size)",
   "datasource": {
    "type": "grafana-opensearch-datasource",
    "uid": "os-metrics"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-opensearch-datasource",
      "uid": "os-metrics"
     },
     "refId": "A",
     "queryType": "lucene",
     "query": "metricset.name:galera_status",
     "timeField": "@timestamp",
     "metrics": [
      {
       "id": "1",
       "type": "max",
       "field": "mysql.galera_status.cluster.size"
      }
     ],
     "bucketAggs": [
      {
       "id": "2",
       "type": "terms",
       "field": "node_name",
       "settings": {
        "size": "10",
        "order": "asc",
        "orderBy": "_term",
        "min_doc_count": "1"
       }
      },
      {
       "id": "3",
       "type": "date_histogram",
       "field": "@timestamp",
       "settings": {
        "interval": "10s",
        "min_doc_count": "0",
        "trimEdges": "0"
       }
      }
     ]
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 2
       },
       {
        "color": "green",
        "value": 3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "orientation": "vertical"
   }
  },
