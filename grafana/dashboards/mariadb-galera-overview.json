{
 "uid": "mariadb-galera-prod",
 "title": "MariaDB Galera - Production Overview",
 "tags": [
  "mariadb",
  "galera",
  "opensearch"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "graphTooltip": 1,
 "editable": true,
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Node availability (probed from vm4, outside the DB nodes)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Host reachable (ping)",
   "description": "1 = VM answers ping, 0 = down",
   "datasource": {
    "type": "grafana-opensearch-datasource",
    "uid": "os-heartbeat"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-opensearch-datasource",
      "uid": "os-heartbeat"
     },
     "query": "check:host_ping",
     "queryType": "lucene",
     "alias": "{{term node_name}}",
     "metrics": [
      {
       "id": "1",
       "type": "min",
       "field": "up_value"
      }
     ],
     "bucketAggs": [
      {
       "id": "2",
       "type": "terms",
       "field": "node_name",
       "settings": {
        "size": "10",
        "order": "asc",
        "orderBy": "_term",
        "min_doc_count": "1"
       }
      },
      {
       "id": "3",
       "type": "date_histogram",
       "field": "@timestamp",
       "settings": {
        "interval": "auto",
        "min_doc_count": "0",
        "trimEdges": "0"
       }
      }
     ],
     "timeField": "@timestamp"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "UP",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "DOWN",
         "color": "red",
         "index": 1
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center"
   }
  },
