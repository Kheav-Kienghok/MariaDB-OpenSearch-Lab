  {
   "id": 4,
   "type": "stat",
   "title": "Galera cluster size seen by each node",
   "description": "3 = healthy. Lower means this node sees a partitioned/shrunk cluster. No data = Metricbeat on that node is down.",
   "datasource": {
    "type": "grafana-opensearch-datasource",
    "uid": "os-metrics"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-opensearch-datasource",
      "uid": "os-metrics"
     },
     "query": "metricset.name:galera_status",
     "queryType": "lucene",
     "alias": "{{term node_name}}",
     "metrics": [
      {
       "id": "1",
       "type": "max",
       "field": "mysql.galera_status.cluster.size"
      }
     ],
     "bucketAggs": [
      {
       "id": "2",
       "type": "terms",
       "field": "node_name",
       "settings": {
        "size": "10",
        "order": "asc",
        "orderBy": "_term",
        "min_doc_count": "1"
       }
      },
      {
       "id": "3",
       "type": "date_histogram",
       "field": "@timestamp",
       "settings": {
        "interval": "auto",
        "min_doc_count": "0",
        "trimEdges": "0"
       }
      }
     ],
     "timeField": "@timestamp"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 2
       },
       {
        "color": "green",
        "value": 3
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
