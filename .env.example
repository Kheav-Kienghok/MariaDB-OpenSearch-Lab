# ---- Copy to .env and edit ----
CLUSTER_NAME=prod_mariadb_cluster
ENVIRONMENT=production

# OpenSearch VM (vm4)
OS_HOST=10.0.1.14
OS_PORT=9200
OS_HEAP=2g
OS_ADMIN_PASSWORD=ChangeMe-Str0ng-Admin!1
OS_VERSION_REPO=2.x

# Filebeat -> OpenSearch writer account (created by 02-opensearch/02-bootstrap.sh)
FILEBEAT_USER=filebeat_writer
FILEBEAT_PASSWORD=ChangeMe-Str0ng-Writer!1

# Filebeat OSS 7.12.1 is the last Filebeat that talks to OpenSearch
FILEBEAT_VERSION=7.12.1

# MariaDB logs
LOG_DIR=/var/log/mariadb
RETENTION_DAYS=14

# ---- MariaDB Galera install (00-install-galera.sh, Ubuntu 24.04) ----
# State transfer account used when a node joins (created on node 1)
SST_USER=sstuser
SST_PASSWORD=ChangeMeSst123
# Empty = 50% of RAM (2G on a 4 GB VM). Example override: 2G
INNODB_BUFFER_POOL=
# Optional: app subnet allowed to reach :3306 through ufw, e.g. 10.0.2.0/24
APP_CIDR=

# ---- Metrics / uptime / Grafana ----
# name=ip pairs of your 3 DB nodes (name must equal `hostname -s` on that node)
DB_NODES="db-node-01=10.0.1.11 db-node-02=10.0.1.12 db-node-03=10.0.1.13"
CHECK_INTERVAL=10s
METRICS_RETENTION_DAYS=30

# Read-only MariaDB account used by Metricbeat (letters/digits only in the password)
MB_MYSQL_USER=metricbeat
MB_MYSQL_PASSWORD=ChangeMeMonitor123

# Grafana (runs on vm4) + its read-only OpenSearch account
GRAFANA_ADMIN_PASSWORD=ChangeMe-Grafana-Admin!1
GRAFANA_READER_USER=grafana_reader
GRAFANA_READER_PASSWORD=ChangeMe-Reader!1
# true = skip TLS verify for localhost -> OpenSearch (demo cert). Use a real cert + false in production.
GRAFANA_TLS_SKIP_VERIFY=true
